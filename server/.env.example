# IncidentLens Environment Configuration

# Hindsight Configuration
# For Hindsight Cloud: base_url="https://api.hindsight.vectorize.io" and your API key
# For local Docker: base_url="http://localhost:8888"
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# Groq Cloud API Key (Free tier at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_BACKUP=optional_backup_groq_key_for_zero_cost_failover
GROQ_MODEL=openai/gpt-oss-120b

# Server Settings
PORT=8000
HOST=0.0.0.0
